#!/usr/bin/env bash
# Standalone CLI front door for MidFlight.
#
# Wraps the existing engine (scripts/query.sh) so MidFlight works outside
# Claude Code — from a terminal, a script, or CI. The engine is unchanged:
# this wrapper only does friendly arg parsing and assembles a query file from
# an inline question (+ optional context/included files) before handing off.
#
# Usage: midflight --help

set -euo pipefail

# Resolve the real location of this script, following symlinks, so the engine
# is found relative to the install location rather than $PWD (works on PATH).
resolve_self() {
  local source="${BASH_SOURCE[0]}" dir
  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

BIN_DIR="$(resolve_self)"
PROJECT_ROOT="$(cd "$BIN_DIR/.." && pwd)"
QUERY_SH="$PROJECT_ROOT/scripts/query.sh"
PLUGIN_JSON="$PROJECT_ROOT/.claude-plugin/plugin.json"

die() {
  printf 'midflight: %s\n' "$1" >&2
  exit "${2:-2}"
}

version() {
  local v=""
  if [ -f "$PLUGIN_JSON" ]; then
    v="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PLUGIN_JSON" | head -1)"
  fi
  printf 'midflight %s\n' "${v:-unknown}"
}

usage() {
  cat <<'EOF'
midflight — consult Codex, Gemini, Antigravity, OpenCode, Oz, Grok, or Claude from any terminal.

Usage:
  midflight [OPTIONS] [QUESTION...]
  midflight --video FILE|URL [QUESTION...]
  midflight --image-gen PROMPT
  midflight --video-gen PROMPT
  midflight -f QUERY_FILE [OPTIONS]

Options:
  -m, --mode MODE        consult | implement | video   (default: consult)
  -p, --provider NAME    codex | gemini | agy | opencode | oz | grok | claude (overrides config)
      --dual PROVIDER    dual-consult: primary from -p/config, plus PROVIDER (consult-only)
      --providers A,B    dual-consult with both providers named explicitly (consult-only)
      --model MODEL      model to use for the active provider (overrides config; not with dual)
  -c, --config FILE      use an alternate config file
  -f, --query-file FILE  send a pre-built query file straight to the engine
      --context FILE      file whose contents become the Context section
  -i, --include GLOB     read matching files into the Context section (repeatable)
      --git-status        append current branch + git status under Context
      --diff              append git diff (working tree) and staged diff under Context
      --video FILE|URL    analyze a video (forces video mode + agy or Gemini)
      --image-gen PROMPT  generate one image with Grok or Codex; prints the file path
      --video-gen PROMPT  generate one video with Grok; prints the file path
      --ref FILE          reference image for --image-gen or --video-gen (repeatable)
      --aspect RATIO      1:1, 16:9, 9:16, 3:2, or 2:3 (image or video generation)
      --timeout SECONDS   hard bound on each provider call (default: off/0; when N>0 the
                          wrapper owns a portable bash watchdog + process-group kill
                          so provider children die too; no coreutils needed; dual ≈ 2N wall)
  -h, --help             show this help
  -V, --version          show version

Dual-consult (--dual / --providers): same question to two providers, print both
answers and a light structural note. Consult-only in v1 (refuse implement/video).
Primary UX: midflight --dual agy "…" (primary from config or -p). Explicit form:
midflight --providers codex,agy "…". Sequential; if one fails, the other is still
shown. MidFlight does not synthesize a merged opinion. --timeout applies per side
(~2N wall-clock for dual).

Git context (--git-status / --diff) is capped at 100 KiB (102400 bytes) per
section. Raise via MIDFLIGHT_GIT_CONTEXT_MAX_BYTES. Requires a git repo and git
on PATH. Combinable with --context / -i / an inline question.

Examples:
  midflight "should we use SSE or WebSockets here?"
  midflight -p agy "is this regex safe against ReDoS?"
  midflight --dual agy "SSE or WebSockets?"
  midflight -p codex --dual grok "SSE or WebSockets?"
  midflight --providers codex,agy "SSE or WebSockets?"
  midflight -p agy --model gemini-3.1-pro-high "quick take on this approach"
  midflight --context notes.md -i "src/*.ts" "where is the leak?"
  midflight --git-status --diff "does this change look right?"
  midflight --diff --context notes.md "any race conditions in the unstaged work?"
  midflight -m implement -f request.md
  midflight --video ./ad.mp4 "does this match the storyboard?"
  midflight --image-gen "a paper plane over a fjord"
  midflight -p codex --image-gen "a paper plane over a fjord"
  midflight --video-gen "the paper plane banks once and levels out"
  midflight --image-gen "a paper plane over a fjord" --aspect 16:9 --ref plane.png

The engine reads ~/.config/mid-flight/config and the provider CLIs from PATH;
see the project README for configuration details.
EOF
}

# Explicit defaults for set -euo pipefail (nounset safety). Arrays use declare -a;
# scalars initialized so [ -n "$VAR" ] and ${VAR} expansions never unbound.
declare -a INCLUDES=()
declare -a POSITIONAL=()
declare -a REFS=()
MODE=""
PROVIDER=""
DUAL_PROVIDER=""
PROVIDERS_LIST=""
MODEL=""
CONFIG_FILE=""
QUERY_FILE=""
CONTEXT_FILE=""
GIT_STATUS=0
GIT_DIFF=0
VIDEO_SOURCE=""
IMAGE_GEN_PROMPT=""
VIDEO_GEN_PROMPT=""
ASPECT=""
TIMEOUT=0  # 0 = no bound by default (preserves pre-timeout behavior & error-path semantics); --timeout N enables the portable watchdog
# Per-section cap for --git-status / --diff output (bytes). Override with MIDFLIGHT_GIT_CONTEXT_MAX_BYTES.
GIT_CONTEXT_MAX_BYTES="${MIDFLIGHT_GIT_CONTEXT_MAX_BYTES:-102400}"

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--mode)       MODE="${2:-}"; shift 2 ;;
    -p|--provider)   PROVIDER="${2:-}"; shift 2 ;;
    --dual)
      [ $# -ge 2 ] || die "--dual requires a provider name (usage: midflight --dual PROVIDER \"…\")"
      [ -n "$2" ] || die "--dual requires a provider name (got empty string)"
      DUAL_PROVIDER="$2"
      shift 2
      ;;
    --providers)     PROVIDERS_LIST="${2:-}"; shift 2 ;;
    --model)         MODEL="${2:-}"; shift 2 ;;
    -c|--config)     CONFIG_FILE="${2:-}"; shift 2 ;;
    -f|--query-file) QUERY_FILE="${2:-}"; shift 2 ;;
    --context)       CONTEXT_FILE="${2:-}"; shift 2 ;;
    -i|--include)    INCLUDES+=("${2:-}"); shift 2 ;;
    --git-status)    GIT_STATUS=1; shift ;;
    --diff)          GIT_DIFF=1; shift ;;
    --video)         VIDEO_SOURCE="${2:-}"; shift 2 ;;
    --image-gen)
      [ $# -ge 2 ] || die "--image-gen requires a prompt"
      [ -n "$2" ] || die "--image-gen requires a prompt"
      case "$2" in
        -*) die "--image-gen requires a prompt (got '$2')" ;;
      esac
      IMAGE_GEN_PROMPT="$2"
      shift 2
      ;;
    --video-gen)
      [ $# -ge 2 ] || die "--video-gen requires a prompt"
      [ -n "$2" ] || die "--video-gen requires a prompt"
      case "$2" in
        -*) die "--video-gen requires a prompt (got '$2')" ;;
      esac
      VIDEO_GEN_PROMPT="$2"
      shift 2
      ;;
    --ref)
      [ $# -ge 2 ] || die "--ref requires a file"
      [ -n "$2" ] || die "--ref requires a file"
      case "$2" in
        -*) die "--ref requires a file (got '$2')" ;;
      esac
      REFS+=("$2")
      shift 2
      ;;
    --aspect)
      [ $# -ge 2 ] || die "--aspect requires a ratio"
      [ -n "$2" ] || die "--aspect requires a ratio"
      [ -z "$ASPECT" ] || die "--aspect was given twice"
      ASPECT="$2"
      shift 2
      ;;
    --timeout)       TIMEOUT="${2:-}"; shift 2 ;;
    -h|--help)       usage; exit 0 ;;
    -V|--version)    version; exit 0 ;;
    --)              shift; while [ $# -gt 0 ]; do POSITIONAL+=("$1"); shift; done ;;
    -*)              die "unknown option: $1" ;;
    *)               POSITIONAL+=("$1"); shift ;;
  esac
done

# --image-gen and --video are separate modes. --video analyzes a file.
if [ -n "$IMAGE_GEN_PROMPT" ] && [ -n "$VIDEO_SOURCE" ]; then
  die "--image-gen cannot be combined with --video"
fi
if [ -n "$IMAGE_GEN_PROMPT" ] && [ -n "$MODE" ]; then
  die "--image-gen cannot be combined with -m/--mode"
fi
if [ -n "$IMAGE_GEN_PROMPT" ]; then
  MODE="image-gen"
fi

# --video-gen generates a clip. --video analyzes a file.
if [ -n "$VIDEO_GEN_PROMPT" ] && [ -n "$IMAGE_GEN_PROMPT" ]; then
  die "--video-gen cannot be combined with --image-gen"
fi
if [ -n "$VIDEO_GEN_PROMPT" ] && [ -n "$VIDEO_SOURCE" ]; then
  die "--video-gen cannot be combined with --video"
fi
if [ -n "$VIDEO_GEN_PROMPT" ] && [ -n "$MODE" ]; then
  die "--video-gen cannot be combined with -m/--mode"
fi
if [ -n "$VIDEO_GEN_PROMPT" ]; then
  MODE="video-gen"
fi

# --video implies video mode; otherwise default to consult.
[ -n "$VIDEO_SOURCE" ] && MODE="video"
[ -z "$MODE" ] && MODE="consult"

case "$MODE" in
  consult|implement|video|image-gen|video-gen) ;;
  *) die "invalid mode '$MODE' (expected consult, implement, or video)" ;;
esac

if [ "$MODE" = "image-gen" ] && [ -z "$IMAGE_GEN_PROMPT" ]; then
  die "image generation requires --image-gen PROMPT"
fi
if [ "$MODE" = "video-gen" ] && [ -z "$VIDEO_GEN_PROMPT" ]; then
  die "video generation requires --video-gen PROMPT"
fi

if [ -n "$ASPECT" ] || [ "${#REFS[@]}" -gt 0 ]; then
  case "$MODE" in
    image-gen|video-gen) ;;
    *) die "--ref and --aspect apply only to --image-gen and --video-gen" ;;
  esac
fi

if [ -n "$ASPECT" ]; then
  case "$ASPECT" in
    1:1|16:9|9:16|3:2|2:3) ;;
    *) die "--aspect must be 1:1, 16:9, 9:16, 3:2, or 2:3 (got '$ASPECT')" ;;
  esac
fi

# Codex image_gen takes pixels. These five match the ratios above and stay
# on a 16px grid, which gpt-image-2 requires.
aspect_codex_size() {
  case "$1" in
    1:1) printf '%s\n' "1024x1024" ;;
    16:9) printf '%s\n' "1536x864" ;;
    9:16) printf '%s\n' "864x1536" ;;
    3:2) printf '%s\n' "1536x1024" ;;
    2:3) printf '%s\n' "1024x1536" ;;
  esac
}

if [ "${#REFS[@]}" -gt 0 ]; then
  resolved_refs=()
  for ref in "${REFS[@]}"; do
    [ -f "$ref" ] || die "reference file not found: $ref"
    ref_dir="$(cd -P "$(dirname "$ref")" && pwd)"
    ref_base="$(basename "$ref")"
    resolved_refs+=("$ref_dir/$ref_base")
  done
  REFS=("${resolved_refs[@]}")
fi

normalize_provider_name() {
  case "$1" in
    antigravity) printf '%s\n' "agy" ;;
    grok-build)  printf '%s\n' "grok" ;;
    *)           printf '%s\n' "$1" ;;
  esac
}

if [ "$MODE" = "image-gen" ] && [ -n "$PROVIDER" ]; then
  PROVIDER="$(normalize_provider_name "$PROVIDER")"
  case "$PROVIDER" in
    codex|grok) ;;
    *) die "--image-gen supports codex and grok (got '$PROVIDER')" ;;
  esac
fi

if [ "$MODE" = "video-gen" ] && [ -n "$PROVIDER" ]; then
  PROVIDER="$(normalize_provider_name "$PROVIDER")"
  case "$PROVIDER" in
    grok) ;;
    *) die "--video-gen supports grok (got '$PROVIDER')" ;;
  esac
fi

provider_label() {
  case "$1" in
    codex) printf '%s\n' "Codex" ;;
    gemini) printf '%s\n' "Gemini" ;;
    agy) printf '%s\n' "Antigravity" ;;
    opencode) printf '%s\n' "OpenCode" ;;
    oz) printf '%s\n' "Oz" ;;
    grok) printf '%s\n' "Grok" ;;
    claude) printf '%s\n' "Claude" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

require_known_provider() {
  local name="$1" flag="$2"
  case "$name" in
    codex|gemini|agy|opencode|oz|grok|claude) ;;
    *) die "unknown provider '$name' for $flag (expected codex, gemini, agy, opencode, oz, grok, or claude)" ;;
  esac
}

# Dual-consult: same question to two providers. Consult-only in v1.
want_dual=0
if [ -n "$DUAL_PROVIDER" ] || [ -n "$PROVIDERS_LIST" ]; then
  want_dual=1
fi

if [ "$want_dual" -eq 1 ]; then
  if [ "$MODE" != "consult" ]; then
    die "dual-consult is consult-only in v1 (refusing mode='$MODE'; omit --dual/--providers or use -m consult)"
  fi
  if [ -n "$VIDEO_SOURCE" ]; then
    die "dual-consult cannot be combined with --video"
  fi
  if [ -n "$DUAL_PROVIDER" ] && [ -n "$PROVIDERS_LIST" ]; then
    die "use either --dual or --providers, not both"
  fi
  if [ -n "$MODEL" ]; then
    die "--model cannot be combined with dual-consult; set per-provider models in ~/.config/mid-flight/config"
  fi
  if [ -z "$DUAL_PROVIDER" ] && [ -z "$PROVIDERS_LIST" ]; then
    die "dual-consult requires --dual PROVIDER or --providers A,B"
  fi
fi

PRIMARY_PROVIDER=""
SECONDARY_PROVIDER=""

resolve_dual_providers() {
  local raw_a="" raw_b="" cfg_provider=""
  if [ -n "$PROVIDERS_LIST" ]; then
    if [ -n "$PROVIDER" ]; then
      die "--providers names both providers; do not also pass -p/--provider"
    fi
    case "$PROVIDERS_LIST" in
      *,*,*) die "--providers expects exactly two names as A,B (got '$PROVIDERS_LIST')" ;;
      *,*) ;;
      *) die "--providers expects exactly two names as A,B (got '$PROVIDERS_LIST')" ;;
    esac
    raw_a="${PROVIDERS_LIST%%,*}"
    raw_b="${PROVIDERS_LIST#*,}"
    raw_a="$(printf '%s' "$raw_a" | tr -d '[:space:]')"
    raw_b="$(printf '%s' "$raw_b" | tr -d '[:space:]')"
    [ -n "$raw_a" ] || die "--providers left side is empty"
    [ -n "$raw_b" ] || die "--providers right side is empty"
    PRIMARY_PROVIDER="$(normalize_provider_name "$raw_a")"
    SECONDARY_PROVIDER="$(normalize_provider_name "$raw_b")"
    require_known_provider "$PRIMARY_PROVIDER" "--providers"
    require_known_provider "$SECONDARY_PROVIDER" "--providers"
  else
    [ -n "$DUAL_PROVIDER" ] || die "dual-consult requires --dual PROVIDER"
    SECONDARY_PROVIDER="$(normalize_provider_name "$(printf '%s' "$DUAL_PROVIDER" | tr -d '[:space:]')")"
    [ -n "$SECONDARY_PROVIDER" ] || die "--dual requires a provider name"
    require_known_provider "$SECONDARY_PROVIDER" "--dual"
    if [ -n "$PROVIDER" ]; then
      PRIMARY_PROVIDER="$(normalize_provider_name "$PROVIDER")"
      require_known_provider "$PRIMARY_PROVIDER" "-p/--provider"
    else
      if [ -n "$CONFIG_FILE" ]; then
        [ -f "$CONFIG_FILE" ] || die "config file not found: $CONFIG_FILE"
        cfg_provider="$(grep '^provider=' "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '[:space:]' || true)"
      elif [ -f "$HOME/.config/mid-flight/config" ]; then
        cfg_provider="$(grep '^provider=' "$HOME/.config/mid-flight/config" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '[:space:]' || true)"
      fi
      if [ -n "$cfg_provider" ]; then
        PRIMARY_PROVIDER="$(normalize_provider_name "$cfg_provider")"
        require_known_provider "$PRIMARY_PROVIDER" "config provider"
      else
        PRIMARY_PROVIDER="codex"
      fi
    fi
  fi
  if [ "$PRIMARY_PROVIDER" = "$SECONDARY_PROVIDER" ]; then
    die "dual-consult needs two different providers (both are '$PRIMARY_PROVIDER')"
  fi
}

if [ -n "$TIMEOUT" ] && ! [[ "$TIMEOUT" =~ ^[0-9]+$ ]]; then
  die "invalid --timeout '$TIMEOUT' (non-negative integer seconds expected; 0 disables the bound)"
fi
[ "${TIMEOUT:-120}" -le 0 ] && TIMEOUT=0  # 0 = no timeout bound (user override)

# Only enforce the cap env when git context is actually requested — a typo/0/abc
# in MIDFLIGHT_GIT_CONTEXT_MAX_BYTES must not break plain `midflight "q?"`.
if [ "$GIT_STATUS" -eq 1 ] || [ "$GIT_DIFF" -eq 1 ]; then
  if ! [[ "$GIT_CONTEXT_MAX_BYTES" =~ ^[0-9]+$ ]] || [ "$GIT_CONTEXT_MAX_BYTES" -le 0 ]; then
    die "invalid MIDFLIGHT_GIT_CONTEXT_MAX_BYTES '$GIT_CONTEXT_MAX_BYTES' (positive integer bytes expected)"
  fi
fi

QUESTION="${POSITIONAL[*]:-}"

WORKDIR=""
# shellcheck disable=SC2317,SC2329  # invoked indirectly via trap (codes vary by shellcheck version)
cleanup() { [ -n "$WORKDIR" ] && [ -d "$WORKDIR" ] && rm -rf "$WORKDIR"; }
trap cleanup EXIT
WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/midflight-cli.XXXXXX")"

# Symlink each entry of src into dest, skipping one name. Lets the temp config
# home mirror the real home so passthrough still resolves there.
# -f: dual-consult calls build_config_home once per side; replace existing links.
# -n: if dest is a symlink, replace it rather than following into a directory.
mirror_dir() {
  local src="$1" dest="$2" skip="$3" entry base
  [ -d "$src" ] || return 0
  for entry in "$src"/* "$src"/.[!.]*; do
    [ -e "$entry" ] || continue
    base="${entry##*/}"
    [ "$base" = "$skip" ] && continue
    ln -sfn "$entry" "$dest/$base"
  done
}

# Build a temporary config home so -p/-c can override config without touching
# the engine or the user's real config. The engine only reads $HOME for the
# config file, but provider CLIs read $HOME for their own auth, so the real
# home's contents are symlinked through; only the mid-flight config is replaced.
#
# Dual-consult invokes this twice (once per provider) into the same WORKDIR.
# Wipe first so a populated real HOME does not make the second `ln` fail with
# "File exists".
build_config_home() {
  local home_dir="$WORKDIR/home"
  rm -rf "$home_dir"
  mkdir -p "$home_dir/.config/mid-flight"
  mirror_dir "$HOME" "$home_dir" ".config"
  mirror_dir "$HOME/.config" "$home_dir/.config" "mid-flight"

  local config="$home_dir/.config/mid-flight/config"
  if [ -n "$CONFIG_FILE" ]; then
    [ -f "$CONFIG_FILE" ] || die "config file not found: $CONFIG_FILE"
    cp "$CONFIG_FILE" "$config"
  elif [ -f "$HOME/.config/mid-flight/config" ]; then
    cp "$HOME/.config/mid-flight/config" "$config"
  else
    : > "$config"
  fi

  if [ -n "$PROVIDER" ]; then
    grep -v '^provider=' "$config" > "$config.tmp" 2>/dev/null || true
    printf 'provider=%s\n' "$PROVIDER" >> "$config.tmp"
    mv "$config.tmp" "$config"
  fi

  if [ -n "$MODEL" ]; then
    local effective_provider="$PROVIDER"
    local write_google_models="false"
    local write_image_models="false"
    local write_video_model="false"

    if [ "$MODE" = "video" ]; then
      case "$effective_provider" in
        gemini|agy|antigravity) ;;
        *)
          # Engine picks agy-if-present else gemini. Stamp both keys.
          write_google_models="true"
          ;;
      esac
    elif [ -z "$effective_provider" ]; then
      effective_provider="$(grep '^provider=' "$config" | cut -d= -f2 | tr -d '[:space:]')"
    fi
    [ -z "$effective_provider" ] && [ "$write_google_models" != "true" ] && effective_provider="codex"

    # image-gen uses grok or codex. A different configured provider is replaced
    # by the engine, so stamp both model keys the fallback might read.
    if [ "$MODE" = "image-gen" ]; then
      case "$effective_provider" in
        codex|grok|grok-build) ;;
        *) write_image_models="true" ;;
      esac
    fi
    if [ "$MODE" = "video-gen" ]; then
      case "$effective_provider" in
        grok|grok-build) ;;
        *) write_video_model="true" ;;
      esac
    fi

    write_model_key() {
      local key="$1"
      grep -v "^${key}=" "$config" > "$config.tmp" 2>/dev/null || true
      printf '%s=%s\n' "$key" "$MODEL" >> "$config.tmp"
      mv "$config.tmp" "$config"
    }

    if [ "$write_google_models" = "true" ]; then
      write_model_key "gemini_model"
      write_model_key "agy_model"
    elif [ "$write_image_models" = "true" ]; then
      write_model_key "grok_model"
      write_model_key "codex_model"
    elif [ "$write_video_model" = "true" ]; then
      write_model_key "grok_model"
    else
      local model_key=""
      case "$effective_provider" in
        codex)             model_key="codex_model" ;;
        gemini)            model_key="gemini_model" ;;
        agy|antigravity)   model_key="agy_model" ;;
        opencode)          model_key="opencode_model" ;;
        oz)                model_key="oz_model" ;;
        grok|grok-build)   model_key="grok_model" ;;
        claude)            model_key="claude_model" ;;
        *)                 die "unknown provider '$effective_provider' for --model mapping" ;;
      esac
      write_model_key "$model_key"
    fi
  fi

  CONFIG_HOME="$home_dir"
}

# Cap a blob to GIT_CONTEXT_MAX_BYTES and print it. On truncation, append a
# clear marker so the model (and the user reading the assembled query) know.
print_capped() {
  local label="$1"
  local content="$2"
  local max="$GIT_CONTEXT_MAX_BYTES"
  local size
  size="$(printf '%s' "$content" | wc -c | tr -d '[:space:]')"
  if [ "$size" -le "$max" ]; then
    printf '%s' "$content"
    # Ensure the section ends with a newline when non-empty.
    [ "$size" -eq 0 ] || [[ "$content" == *$'\n' ]] || printf '\n'
    return 0
  fi
  printf '%s' "$content" | head -c "$max"
  printf '\n\n[midflight: truncated %s at %s bytes; set MIDFLIGHT_GIT_CONTEXT_MAX_BYTES to raise the limit]\n' \
    "$label" "$max"
}

# Fail fast when --git-status / --diff need git but the cwd is not a repo
# (or git is missing from PATH).
require_git_repo() {
  if ! command -v git >/dev/null 2>&1; then
    die "git is required for --git-status/--diff but was not found on PATH"
  fi
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "not a git repository (or any parent); --git-status/--diff require a work tree"
  fi
}

# Append git-derived subsections (branch/status and/or diffs) into the Context
# body. Color is forced off so the prompt stays plain text.
append_git_context() {
  local branch="" status="" unstaged="" staged=""
  local cap=$((GIT_CONTEXT_MAX_BYTES + 1))

  require_git_repo

  if [ "$GIT_STATUS" -eq 1 ]; then
    branch="$(git branch --show-current 2>/dev/null || true)"
    if [ -z "$branch" ]; then
      branch="detached HEAD @ $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    status="$(git -c color.ui=false status 2>&1)" || true
    printf '\n### git branch\n'
    print_capped "git branch" "$branch"
    printf '\n### git status\n'
    print_capped "git status" "$status"
  fi

  if [ "$GIT_DIFF" -eq 1 ]; then
    # Stream-cap at max+1 bytes so we detect truncation without slurping a huge diff.
    unstaged="$(git -c color.ui=false diff 2>&1 | head -c "$cap" || true)"
    staged="$(git -c color.ui=false diff --cached 2>&1 | head -c "$cap" || true)"
    printf '\n### git diff (working tree)\n'
    if [ -n "$unstaged" ]; then
      print_capped "git diff (working tree)" "$unstaged"
    else
      printf '(empty)\n'
    fi
    printf '\n### git diff --cached (staged)\n'
    if [ -n "$staged" ]; then
      print_capped "git diff --cached (staged)" "$staged"
    else
      printf '(empty)\n'
    fi
  fi
}

# Assemble an inline question (+ optional context/includes/git) into a query
# file, mirroring the "## Context / ## Question" structure the plugin produces.
# Sets QUERY_OUT to the assembled file path.
build_query_file() {
  # Separate locals + explicit array init for set -u safety (the previous
  # combined "local ... pat file" + "local -a files=()" was mangling the
  # array under nounset when the Context body executed).
  local out="$WORKDIR/query.md"
  local context=""
  local pat=""
  local file=""
  local fence='```'
  local want_context=0
  local -a files
  files=()  # split decl-then-assign is the portable idiom for bash 3.2 + set -u + arrays in functions (combined local -a foo=() leaves the local uninitialized for ${} expansions on macOS)

  if [ -n "$CONTEXT_FILE" ]; then
    [ -f "$CONTEXT_FILE" ] || die "context file not found: $CONTEXT_FILE"
    context="$(cat "$CONTEXT_FILE")"
  fi

  if [ "${#INCLUDES[@]}" -gt 0 ]; then
    for pat in "${INCLUDES[@]}"; do
      [ -n "$pat" ] || continue
      # shellcheck disable=SC2086 # intentional glob expansion of the pattern
      for file in $pat; do
        [ -f "$file" ] && files+=("$file")
      done
    done
  fi

  if [ -n "$context" ] || [ "${#files[@]}" -gt 0 ] \
    || [ "$GIT_STATUS" -eq 1 ] || [ "$GIT_DIFF" -eq 1 ]; then
    want_context=1
  fi

  {
    if [ "$want_context" -eq 1 ]; then
      printf '## Context\n'
      [ -n "$context" ] && printf '%s\n' "$context"
      if [ "$GIT_STATUS" -eq 1 ] || [ "$GIT_DIFF" -eq 1 ]; then
        append_git_context
      fi
      for file in ${files[@]+"${files[@]}"}; do
        printf '\n### %s\n%s\n%s\n%s\n' "$file" "$fence" "$(cat "$file")" "$fence"
      done
      printf '\n'
    fi
    printf '## Question\n%s\n' "$QUESTION"
  } > "$out"

  QUERY_OUT="$out"
}

have_inline_input() {
  # Git flags alone are not enough — they decorate Context but still need a QUESTION
  # (or --query-file / --video). See the require-QUESTION check below.
  [ -n "$QUESTION" ] || [ -n "$CONTEXT_FILE" ] || [ "${#INCLUDES[@]}" -gt 0 ]
}

have_git_flags() {
  [ "$GIT_STATUS" -eq 1 ] || [ "$GIT_DIFF" -eq 1 ]
}

# run_engine: invoke the engine (bash QUERY_SH ...) under an optional wall-time
# bound owned by the wrapper. Uses portable pure-bash watchdog + process group
# (set -m + kill -$pgid) so that provider children (codex etc that fork helpers)
# are reliably reaped on timeout. Watchdog output redirected + explicit kill of
# the sleeper to avoid "Terminated" noise on the happy path (even in scripts that
# may have job monitoring).
run_engine() {
  local to="${TIMEOUT:-0}"
  if [ "$to" -gt 0 ] 2>/dev/null; then
    # Portable watchdog (no coreutils): own process group for children, clean
    # kill on timeout, visible msg, nonzero exit, and no "Terminated" noise from
    # *our* sleeper on happy path (redirect + explicit reap; engine may still
    # print its own internal job noise when we nuke the provider call).
    bash -c '
      set -m
      "$@" &
      pg=$!
      exec 3>&2
      (
        sleep '"$to"'
        printf "midflight: timed out after %ss waiting for provider response\n" '"$to"' >&3
        kill -TERM -"$pg" 2>/dev/null || true
        sleep 1
        kill -9 -"$pg" 2>/dev/null || true
        # Force the parent (-c) to die nonzero so caller sees failure even if
        # the killed QUERY_SH script would have exited 0.
        kill -TERM $PPID 2>/dev/null || true
      ) 3>&2 >/dev/null 2>&1 &
      k=$!
      wait "$pg" 2>/dev/null || true
      ec=$?
      kill "$k" 2>/dev/null || true
      wait "$k" 2>/dev/null || true
      exit "$ec"
    ' _ "$@"
  else
    "$@"
  fi
}

# Determine engine arguments by mode.
declare -a engine_args
if [ "$MODE" = "image-gen" ] || [ "$MODE" = "video-gen" ]; then
  if [ "$MODE" = "image-gen" ]; then
    media_flag="--image-gen"
    media_prompt="$IMAGE_GEN_PROMPT"
    media_noun="image description"
  else
    media_flag="--video-gen"
    media_prompt="$VIDEO_GEN_PROMPT"
    media_noun="video description"
  fi
  [ -z "$QUERY_FILE" ] || die "$media_flag cannot be combined with --query-file"
  if [ -n "$CONTEXT_FILE" ] || [ "${#INCLUDES[@]}" -gt 0 ] || have_git_flags; then
    die "--context/--include/--git-status/--diff do not apply to $media_flag"
  fi
  if [ -n "$QUESTION" ]; then
    die "pass the $media_noun to $media_flag, not as a separate question"
  fi
  media_prompt_file="$WORKDIR/media-prompt.md"
  {
    printf '%s\n' "$media_prompt"
    if [ -n "$ASPECT" ]; then
      printf '\nAspect ratio: %s\n' "$ASPECT"
      if [ "$MODE" = "image-gen" ]; then
        printf 'Codex size: %s\n' "$(aspect_codex_size "$ASPECT")"
      elif [ "${#REFS[@]}" -gt 0 ]; then
        printf '%s\n' "The opening frame already exists. Do not pass aspect_ratio to image_to_video."
      else
        printf '%s\n' "Set this ratio on the source still with image_gen. Do not pass aspect_ratio to image_to_video."
      fi
    fi
    if [ "${#REFS[@]}" -gt 0 ]; then
      printf '\nReference images:\n'
      ref_index=0
      for ref in "${REFS[@]}"; do
        if [ "$MODE" = "video-gen" ] && [ "$ref_index" -eq 0 ]; then
          printf -- '- opening frame: %s\n' "$ref"
        else
          printf -- '- %s\n' "$ref"
        fi
        ref_index=$((ref_index + 1))
      done
    fi
  } > "$media_prompt_file"
  if [ "${#REFS[@]}" -gt 0 ]; then
    refs_file="$WORKDIR/media-refs.txt"
    printf '%s\n' "${REFS[@]}" > "$refs_file"
    export MIDFLIGHT_REFS_FILE="$refs_file"
  fi
  engine_args=("$media_prompt_file" "$MODE")
elif [ "$MODE" = "video" ]; then
  [ -n "$VIDEO_SOURCE" ] || die "video mode requires --video FILE|URL"
  [ -z "$QUERY_FILE" ] || die "--query-file cannot be combined with --video"
  if [ -n "$CONTEXT_FILE" ] || [ "${#INCLUDES[@]}" -gt 0 ] || have_git_flags; then
    die "--context/--include/--git-status/--diff do not apply to video mode; pass the prompt inline"
  fi
  engine_args=("$VIDEO_SOURCE" "video")
  [ -n "$QUESTION" ] && engine_args+=("$QUESTION")
elif [ -n "$QUERY_FILE" ]; then
  [ -f "$QUERY_FILE" ] || die "query file not found: $QUERY_FILE"
  if have_inline_input || have_git_flags; then
    die "--query-file cannot be combined with an inline question, --context, --include, --git-status, or --diff"
  fi
  engine_args=("$QUERY_FILE" "$MODE")
else
  if have_git_flags && [ -z "$QUESTION" ]; then
    die "--git-status/--diff require a QUESTION (or use --query-file/--video)"
  fi
  have_inline_input || die "no question provided (give a QUESTION, --query-file, or --video)"
  QUERY_OUT=""
  build_query_file
  engine_args=("$QUERY_OUT" "$MODE")
fi

# Capture one engine run's stdout/stderr/exit for dual-consult formatting.
run_engine_capture() {
  local out_file="$1" err_file="$2" ec_file="$3"
  shift 3
  set +e
  run_engine "$@" >"$out_file" 2>"$err_file"
  printf '%s' "$?" >"$ec_file"
  set -e
}

print_dual_report() {
  local label_a="$1" name_a="$2" status_a="$3" body_a="$4"
  local label_b="$5" name_b="$6" status_b="$7" body_b="$8"
  local trimmed_a trimmed_b

  printf '## %s: %s\n\n' "$label_a" "$name_a"
  printf '%s\n\n' "$body_a"
  printf '## %s: %s\n\n' "$label_b" "$name_b"
  printf '%s\n\n' "$body_b"
  printf '## Where they differ\n\n'
  if [ "$status_a" -ne 0 ] && [ "$status_b" -ne 0 ]; then
    printf 'Both providers failed; no answers to compare.\n'
  elif [ "$status_a" -ne 0 ]; then
    printf "%s failed; only %s's answer is available above.\n" "$name_a" "$name_b"
  elif [ "$status_b" -ne 0 ]; then
    printf "%s failed; only %s's answer is available above.\n" "$name_b" "$name_a"
  else
    trimmed_a="$(printf '%s' "$body_a" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    trimmed_b="$(printf '%s' "$body_b" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    if [ "$trimmed_a" = "$trimmed_b" ]; then
      printf 'Responses are identical (after trim). MidFlight does not synthesize a merged opinion.\n'
    else
      printf 'Both answers are printed above. Compare them directly — MidFlight does not invent a disagreement analysis.\n'
    fi
  fi
}

if [ "$want_dual" -eq 1 ]; then
  resolve_dual_providers

  out_a="$WORKDIR/dual_a.out"
  err_a="$WORKDIR/dual_a.err"
  ec_a_file="$WORKDIR/dual_a.ec"
  out_b="$WORKDIR/dual_b.out"
  err_b="$WORKDIR/dual_b.err"
  ec_b_file="$WORKDIR/dual_b.ec"

  # Primary
  PROVIDER="$PRIMARY_PROVIDER"
  CONFIG_HOME=""
  build_config_home
  run_engine_capture "$out_a" "$err_a" "$ec_a_file" env HOME="$CONFIG_HOME" bash "$QUERY_SH" "${engine_args[@]}"
  # Secondary
  PROVIDER="$SECONDARY_PROVIDER"
  CONFIG_HOME=""
  build_config_home
  run_engine_capture "$out_b" "$err_b" "$ec_b_file" env HOME="$CONFIG_HOME" bash "$QUERY_SH" "${engine_args[@]}"

  # Keep provider logs on stderr (prefixed) so dual stdout stays the product.
  if [ -s "$err_a" ]; then
    sed "s/^/[$(provider_label "$PRIMARY_PROVIDER")] /" "$err_a" >&2 || true
  fi
  if [ -s "$err_b" ]; then
    sed "s/^/[$(provider_label "$SECONDARY_PROVIDER")] /" "$err_b" >&2 || true
  fi

  status_a="$(cat "$ec_a_file")"
  status_b="$(cat "$ec_b_file")"
  body_a="$(cat "$out_a")"
  body_b="$(cat "$out_b")"
  # Trim a single trailing newline for cleaner section bodies (printf adds one).
  body_a="${body_a%"${body_a##*[![:space:]]}"}"
  body_b="${body_b%"${body_b##*[![:space:]]}"}"

  print_dual_report     "Provider A" "$(provider_label "$PRIMARY_PROVIDER")" "$status_a" "$body_a"     "Provider B" "$(provider_label "$SECONDARY_PROVIDER")" "$status_b" "$body_b"

  if [ "$status_a" -eq 0 ] && [ "$status_b" -eq 0 ]; then
    exit 0
  fi
  exit 1
fi

# Resolve a path that exists right now. cd -P follows the temp-HOME symlink
# into the real ~/.grok (or ~/.codex) before this process deletes the temp dir.
resolve_existing_path() {
  local target="$1" dir base
  dir="$(cd -P "$(dirname "$target")" && pwd)"
  base="$(basename "$target")"
  printf '%s\n' "$dir/$base"
}

# Drop a trailing period or comma the model glues onto a path.
strip_path_punctuation() {
  local candidate="$1" lastchar
  while [ -n "$candidate" ]; do
    lastchar="${candidate#"${candidate%?}"}"
    case "$lastchar" in
      "."|","|":"|";") candidate="${candidate%?}" ;;
      *) break ;;
    esac
  done
  printf '%s\n' "$candidate"
}

written_since_gen_stamp() {
  local file="$1"
  if [ -z "${GEN_STAMP:-}" ] || [ ! -f "$GEN_STAMP" ] || [ ! -f "$file" ]; then
    return 1
  fi
  if [ "$file" -ef "$GEN_STAMP" ]; then
    return 1
  fi
  [ ! "$file" -ot "$GEN_STAMP" ]
}

last_written_path() {
  local text="$1" i len rest candidate found=""
  case "$text" in
    \"*\") text="${text#\"}"; text="${text%\"}" ;;
    \'*\') text="${text#\'}"; text="${text%\'}" ;;
  esac
  len=${#text}
  i=0
  while [ "$i" -lt "$len" ]; do
    rest="${text:$i}"
    case "$rest" in
      /*)
        candidate="$rest"
        while [ -n "$candidate" ]; do
          candidate="$(strip_path_punctuation "$candidate")"
          case "$candidate" in
            *\"|*\') candidate="${candidate%?}"; continue ;;
          esac
          if written_since_gen_stamp "$candidate"; then
            found="$candidate"
            break
          fi
          candidate="${candidate%?}"
        done
        ;;
    esac
    i=$((i + 1))
  done
  printf '%s\n' "$found"
}

is_video_file() {
  local base
  base="$(basename "$1")"
  case "$base" in
    *.mp4|*.MP4|*.mov|*.MOV|*.webm|*.WEBM|*.m4v|*.M4V|*.mkv|*.MKV) return 0 ;;
    *) return 1 ;;
  esac
}

is_reference_file() {
  local candidate="$1" ref
  [ "${#REFS[@]}" -gt 0 ] || return 1
  for ref in "${REFS[@]}"; do
    if [ "$candidate" -ef "$ref" ]; then
      return 0
    fi
  done
  return 1
}

# Last saved video in the reply. A reference image the model mentions does
# not count, even when that file exists.
last_written_video_path() {
  local text="$1" i len rest candidate found=""
  case "$text" in
    \"*\") text="${text#\"}"; text="${text%\"}" ;;
    \'*\') text="${text#\'}"; text="${text%\'}" ;;
  esac
  len=${#text}
  i=0
  while [ "$i" -lt "$len" ]; do
    rest="${text:$i}"
    case "$rest" in
      /*)
        candidate="$rest"
        while [ -n "$candidate" ]; do
          candidate="$(strip_path_punctuation "$candidate")"
          case "$candidate" in
            *\"|*\') candidate="${candidate%?}"; continue ;;
          esac
          if written_since_gen_stamp "$candidate" && is_video_file "$candidate" && ! is_reference_file "$candidate"; then
            found="$candidate"
            break
          fi
          candidate="${candidate%?}"
        done
        ;;
    esac
    i=$((i + 1))
  done
  if [ -n "$found" ]; then
    resolve_existing_path "$found"
    return 0
  fi
  return 1
}

# -p/--model/--config runs the engine under a temp HOME so the real config
# stays untouched. The model sometimes prints a sentence plus a path inside
# that temp HOME.
# Return 1 when the reply names no saved file.
canonicalize_image_output() {
  local body="$1" trimmed found
  trimmed="${body%"${body##*[![:space:]]}"}"
  trimmed="${trimmed#"${trimmed%%[![:space:]]*}"}"
  if [ -n "$trimmed" ] && written_since_gen_stamp "$trimmed"; then
    resolve_existing_path "$trimmed"
    return 0
  fi
  found="$(last_written_path "$trimmed")"
  if [ -n "$found" ]; then
    resolve_existing_path "$found"
    return 0
  fi
  return 1
}

if [ "$MODE" = "image-gen" ] || [ "$MODE" = "video-gen" ]; then
  media_out="$WORKDIR/media-gen.out"
  GEN_STAMP="$WORKDIR/gen-stamp"
  touch "$GEN_STAMP"
  set +e
  if [ -n "$PROVIDER" ] || [ -n "$MODEL" ] || [ -n "$CONFIG_FILE" ]; then
    CONFIG_HOME=""
    build_config_home
    HOME="$CONFIG_HOME" run_engine bash "$QUERY_SH" "${engine_args[@]}" >"$media_out"
  else
    run_engine bash "$QUERY_SH" "${engine_args[@]}" >"$media_out"
  fi
  ec=$?
  set -e
  if [ "$ec" -eq 0 ]; then
    if [ "$MODE" = "video-gen" ]; then
      resolved="$(last_written_video_path "$(cat "$media_out")" || true)"
    else
      resolved="$(canonicalize_image_output "$(cat "$media_out")" || true)"
    fi
    if [ -n "$resolved" ] && [ -f "$resolved" ]; then
      printf '%s\n' "$resolved"
      exit 0
    fi
    if [ "$MODE" = "video-gen" ]; then
      printf 'midflight: video-gen did not produce a saved video file\n' >&2
    else
      printf 'midflight: image-gen did not produce a saved image file\n' >&2
    fi
    if [ -s "$media_out" ]; then
      cat "$media_out" >&2
    fi
    exit 1
  fi
  cat "$media_out"
  exit "$ec"
fi

if [ -n "$PROVIDER" ] || [ -n "$MODEL" ] || [ -n "$CONFIG_FILE" ]; then
  CONFIG_HOME=""
  build_config_home
  HOME="$CONFIG_HOME" run_engine bash "$QUERY_SH" "${engine_args[@]}"
  ec=$?
else
  run_engine bash "$QUERY_SH" "${engine_args[@]}"
  ec=$?
fi
exit "${ec:-0}"
